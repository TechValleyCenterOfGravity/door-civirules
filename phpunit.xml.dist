<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unit tests for the wire contract only. These deliberately do not bootstrap
  CiviCRM: CRM_CivirulesActions_DoorSync_Contract has no CiviCRM dependencies,
  so `composer test` runs anywhere PHP does, including CI.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="unit">
      <directory>tests/phpunit</directory>
    </testsuite>
  </testsuites>
</phpunit>
